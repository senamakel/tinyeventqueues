{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tinyhumansai/tinyeventqueues/main/schemas/pipeline.schema.json",
  "title": "tinyeventqueues pipeline configuration",
  "description": "The tunables of the inbound event pipeline. Loaded by tinyeventqueues::config::load_pipeline_config, which rejects unknown fields and names the offending field in every error. Queue names refer to queues declared in queues.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ingress",
    "dead_letter",
    "lanes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This schema's URL, for editors. Not interpreted."
    },
    "version": {
      "const": 1,
      "description": "Configuration format version."
    },
    "ingress": {
      "$ref": "#/$defs/ingress"
    },
    "dead_letter": {
      "$ref": "#/$defs/dead_letter"
    },
    "lanes": {
      "$ref": "#/$defs/lanes"
    },
    "sources": {
      "type": "array",
      "description": "Per-source policies, first match wins. A source no entry matches gets every default.",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "gate": {
      "$ref": "#/$defs/gate"
    },
    "coalesce": {
      "$ref": "#/$defs/coalesce"
    },
    "salience": {
      "$ref": "#/$defs/salience"
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "dispatch": {
      "$ref": "#/$defs/dispatch"
    }
  },
  "$defs": {
    "queue_name": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,64}$",
      "description": "A queue declared in queues.json, with a visibility_ms."
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue"
      ],
      "properties": {
        "queue": {
          "$ref": "#/$defs/queue_name"
        },
        "tombstone_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 2592000000,
          "description": "How long a completed event keeps rejecting redeliveries, in milliseconds, when the queue backend cannot dedupe."
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 64,
          "description": "Ingress messages taken per pipeline pass."
        }
      }
    },
    "dead_letter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue"
      ],
      "properties": {
        "queue": {
          "$ref": "#/$defs/queue_name"
        }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interactive",
        "actionable",
        "background",
        "digest"
      ],
      "properties": {
        "interactive": {
          "$ref": "#/$defs/lane"
        },
        "actionable": {
          "$ref": "#/$defs/lane"
        },
        "background": {
          "$ref": "#/$defs/lane"
        },
        "digest": {
          "$ref": "#/$defs/lane"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue"
      ],
      "properties": {
        "queue": {
          "$ref": "#/$defs/queue_name"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 4,
          "description": "Turns of this lane in flight at once, across conversations."
        },
        "max_backlog": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "Turns the lane may hold waiting; past it, new work spills to the digest (lane_overflow). Ignored for the digest lane."
        },
        "cadence": {
          "$ref": "#/$defs/cadence"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match"
      ],
      "properties": {
        "match": {
          "type": "string",
          "minLength": 1,
          "description": "An exact source (channel:telegram), a prefix ending in * (channel:*), or * for every source."
        },
        "ack": {
          "enum": [
            "after_ingest",
            "after_dispatch",
            "after_turn"
          ],
          "default": "after_ingest",
          "description": "When the platform may be acknowledged."
        },
        "weight": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "default": 0,
          "description": "Salience points the source adds, or takes away when negative."
        },
        "cadence": {
          "$ref": "#/$defs/cadence"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "coalesce": {
          "$ref": "#/$defs/sourceCoalesce"
        }
      }
    },
    "sender_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Sender ids, or <source>/<sender id> to name one source's sender."
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Deterministic checks that decide, without a model, whether an event may go on towards the agent.",
      "properties": {
        "allow_senders": {
          "$ref": "#/$defs/sender_list",
          "description": "If not empty, only these senders pass."
        },
        "deny_senders": {
          "$ref": "#/$defs/sender_list",
          "description": "These senders never pass. Wins over allow_senders."
        },
        "direct_messages": {
          "type": "boolean",
          "default": true,
          "description": "Direct messages may reach the agent."
        },
        "groups": {
          "type": "boolean",
          "default": true,
          "description": "Group conversations may reach the agent."
        },
        "bot_loop": {
          "$ref": "#/$defs/bot_loop"
        },
        "rate_limits": {
          "$ref": "#/$defs/rate_limits"
        },
        "ambient": {
          "$ref": "#/$defs/ambient"
        }
      }
    },
    "bot_loop": {
      "type": "object",
      "additionalProperties": false,
      "description": "A bot sending more than max_events into one conversation within window_ms is looping; the excess is dropped.",
      "properties": {
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "window_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 60000
        }
      }
    },
    "rate_limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Token buckets; an event over any of them spills to the digest lane. A missing bucket is unlimited.",
      "properties": {
        "per_sender": {
          "$ref": "#/$defs/rate_limit"
        },
        "per_conversation": {
          "$ref": "#/$defs/rate_limit"
        },
        "per_source": {
          "$ref": "#/$defs/rate_limit"
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity",
        "refill_per_minute"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "description": "Burst size."
        },
        "refill_per_minute": {
          "type": "integer",
          "minimum": 1,
          "description": "Tokens added per minute."
        }
      }
    },
    "ambient": {
      "type": "object",
      "additionalProperties": false,
      "description": "Unaddressed group chatter kept per conversation and surfaced with its next turn.",
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 50,
          "description": "Events kept per conversation; the oldest are evicted."
        }
      }
    },
    "coalesce": {
      "type": "object",
      "additionalProperties": false,
      "description": "The debounce buffer keyed by conversation, thread and sender.",
      "properties": {
        "debounce_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 1500,
          "description": "Flush this long after a key's last event."
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 10000,
          "description": "Flush this long after a key's first event at the latest."
        },
        "control_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "/"
          ],
          "description": "Text prefixes that mark a control command, which flushes at once."
        }
      }
    },
    "salience": {
      "type": "object",
      "additionalProperties": false,
      "description": "How much an event deserves attention (0-100) and which lane that earns it.",
      "properties": {
        "weights": {
          "$ref": "#/$defs/salience_weights"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Words that mark an event as worth attention, case-insensitive."
        },
        "known_contacts": {
          "$ref": "#/$defs/sender_list",
          "description": "Senders the agent knows."
        },
        "thresholds": {
          "$ref": "#/$defs/salience_thresholds"
        },
        "borderline": {
          "$ref": "#/$defs/borderline"
        },
        "habituation": {
          "$ref": "#/$defs/habituation"
        }
      }
    },
    "salience_weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 25,
          "description": "Points every event starts with."
        },
        "addressed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50,
          "description": "Addressed to the agent, or a mention."
        },
        "direct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50,
          "description": "A direct message."
        },
        "known_contact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 15,
          "description": "A known contact."
        },
        "keyword": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20,
          "description": "The text holds a keyword."
        },
        "age_penalty_per_minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 1,
          "description": "Points lost per minute of age."
        },
        "max_age_penalty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20,
          "description": "The most points age can cost."
        }
      }
    },
    "salience_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "description": "The lowest score of each lane, interactive >= actionable >= background. Below background an event is noise and goes to the digest.",
      "properties": {
        "interactive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 70,
          "description": "Lowest interactive score."
        },
        "actionable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 40,
          "description": "Lowest actionable score."
        },
        "background": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 15,
          "description": "Lowest background score."
        }
      }
    },
    "borderline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "high",
        "budget_per_hour"
      ],
      "description": "Scores in low..high are classified by the host's ClassifySalience, within an hourly budget.",
      "properties": {
        "low": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "high": {
          "type": "integer",
          "minimum": 1,
          "maximum": 101
        },
        "budget_per_hour": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "habituation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Content a source repeats loses salience.",
      "properties": {
        "window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 64,
          "description": "Fingerprints kept per source."
        },
        "window_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 3600000,
          "description": "How long a fingerprint counts."
        },
        "max_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "default": 3,
          "description": "Most differing SimHash bits for a near-duplicate."
        },
        "decay_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 40,
          "description": "Share of the score each near-duplicate takes."
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Spilled, overflowing and noisy events gather here and go out as one digest turn.",
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 200,
          "description": "Release a digest turn at this many events."
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 600000,
          "description": "Release a digest turn this long after its first event at the latest."
        }
      }
    },
    "cadence": {
      "type": "string",
      "pattern": "^(instant|every\\(\\s*[0-9]+(ms|s|m|h|d)\\s*\\)|cron\\(.*\\))$",
      "description": "instant, every(<n><ms|s|m|h|d>) or cron(\"<min> <hour> <day> <month> <weekday>\") in UTC."
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns"
      ],
      "description": "An ingestion budget for a cadence.",
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "description": "Turns released per tick; for an instant cadence, per second."
        },
        "backlog_ticks": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Waiting turns beyond max_turns * backlog_ticks fold into the digest."
        },
        "degrade_debounce_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 5000,
          "description": "An instant cadence over budget holds new turns this long, folding each conversation's events into one."
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "description": "Delivery to the host. Retries back off exponentially; a turn that uses up its lane queue's manifest max_attempts is dead-lettered.",
      "properties": {
        "backoff_base_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "The first retry delay."
        },
        "backoff_max_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 300000,
          "description": "The longest retry delay; at least backoff_base_ms."
        },
        "gap_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "default": 120000,
          "description": "On a queue backend without groups, how long a conversation waits for a turn lost to a crash before skipping it."
        }
      }
    },
    "sourceCoalesce": {
      "type": "object",
      "additionalProperties": false,
      "description": "The source's own debounce. A field left out keeps the pipeline's coalesce value.",
      "properties": {
        "debounce_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Flush this long after a buffer's last event, in milliseconds."
        },
        "max_wait_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Flush this long after a buffer's first event at the latest, in milliseconds."
        },
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "description": "A buffer holding this many events flushes at once, and one turn carries at most this many."
        }
      }
    }
  }
}
